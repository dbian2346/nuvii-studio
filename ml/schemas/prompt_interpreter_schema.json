{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nuvii NailSetSpec",
  "description": "Canonical structured design plan used by the Nuvii Smart AI controller.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "shape": {
      "type": "string",
      "enum": ["almond", "oval", "square", "coffin", "stiletto"]
    },
    "length": {
      "type": "string",
      "enum": ["short", "medium", "long"]
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "finish": {
      "type": "string",
      "enum": ["glossy", "matte", "chrome", "glitter", "jelly"]
    },
    "styleTags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "strategy": {
      "type": "string",
      "enum": ["library", "hybrid", "generative"]
    },
    "requiredConcepts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbiddenConcepts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "novelConcepts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diffusionPrompt": { "type": "string" },
    "negativePrompt": { "type": "string" },
    "designSummary": { "type": "string" },
    "nails": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finger": {
            "type": "string",
            "enum": ["pinky", "ring", "middle", "index", "thumb"]
          },
          "baseColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "finish": {
            "type": "string",
            "enum": ["glossy", "matte", "chrome", "glitter", "jelly"]
          },
          "elements": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "assetId": { "type": "string" },
                "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "x": { "type": "number", "minimum": 0, "maximum": 100 },
                "y": { "type": "number", "minimum": 0, "maximum": 180 },
                "scale": { "type": "number", "minimum": 1, "maximum": 200 },
                "rotation": { "type": "number", "minimum": -180, "maximum": 180 },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": ["assetId", "color", "x", "y", "scale", "rotation", "opacity"]
            }
          }
        },
        "required": ["finger", "baseColor", "finish", "elements"]
      }
    }
  },
  "required": [
    "shape",
    "length",
    "palette",
    "finish",
    "styleTags",
    "strategy",
    "requiredConcepts",
    "forbiddenConcepts",
    "novelConcepts",
    "diffusionPrompt",
    "negativePrompt",
    "designSummary",
    "nails"
  ]
}
