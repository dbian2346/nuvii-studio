# Copy this file to .env.local. The startup script loads it before FastAPI.
NUVII_BASE_MODEL=segmind/SSD-1B
# May be absolute or relative to apps/ai-service. This exact file is authoritative.
NUVII_LORA_PATH=./model/pytorch_lora_weights.safetensors
NUVII_CHECKPOINT_DIR=./model/checkpoints
NUVII_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUVII_DEVICE=auto
NUVII_STEPS=30
NUVII_GUIDANCE=9.0
