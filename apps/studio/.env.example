# Local trained Nuvii AI service used by the Next.js server-side proxy.
NUVII_AI_SERVICE_URL=http://127.0.0.1:8000

# Optional but strongly recommended: enables structured prompt interpretation and
# visual candidate judging. Keep this server-side; never expose it with NEXT_PUBLIC_.
OPENAI_API_KEY=
NUVII_OPENAI_MODEL=gpt-5.4-mini
